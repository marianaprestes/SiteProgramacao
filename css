/* ===== RESET & BASE ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --azul-piscina: #00A8E8;
    --laranja-solar: #FF6B35;
    --azul-escuro: #003B5C;
    --verde-energia: #7ED321;
    --amarelo-sol: #FFD93D;
    --branco: #FFFFFF;
    --cinza-claro: #F5F5F5;
    --cinza-medio: #999999;
    --sombra: 0 4px 6px rgba(0, 0, 0, 0.1);
    --sombra-hover: 0 10px 20px rgba(0, 0, 0, 0.15);
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Open Sans', sans-serif;
    line-height: 1.6;
    color: var(--azul-escuro);
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    line-height: 1.2;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.section {
    padding: 80px 0;
}

.section-title {
    font-size: 36px;
    text-align: center;
    margin-bottom: 15px;
    color: var(--azul-escuro);
}

.section-subtitle {
    text-align: center;
    font-size: 18px;
    color: var(--cinza-medio);
    margin-bottom: 50px;
}

/* ===== HEADER ===== */
.header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: var(--branco);
    box-shadow: var(--sombra);
    z-index: 1000;
    transition: all 0.3s ease;
}

.header.scrolled {
    background: rgba(255, 255, 255, 0.98);
}

.header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 24px;
    color: var(--azul-piscina);
}

.logo i {
    font-size: 32px;
}

.nav-list {
    display: flex;
    list-style: none;
    gap: 30px;
}

.nav-link {
    text-decoration: none;
    color: var(--azul-escuro);
    font-weight: 600;
    transition: color 0.3s;
    position: relative;
}

.nav-link:hover,
.nav-link.active {
    color: var(--azul-piscina);
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--azul-piscina);
    transition: width 0.3s;
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 100%;
}

.menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: var(--azul-escuro);
}

/* ===== HERO SECTION ===== */
.hero {
    position: relative;
    height: 100vh;
    background: linear-gradient(135deg, var(--azul-piscina), var(--azul-escuro));
    background-image: url('piscinacep.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--branco);
    overflow: hidden;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 59, 92, 0.6);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    padding: 0 20px;
    animation: fadeInUp 1s ease;
}

.hero-title {
    font-size: 56px;
    margin-bottom: 20px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.hero-subtitle {
    font-size: 28px;
    margin-bottom: 15px;
    font-weight: 400;
}

.hero-text {
    font-size: 18px;
    margin-bottom: 40px;
    opacity: 0.9;
}

.hero-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    padding: 15px 40px;
    border: none;
    border-radius: 50px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
}

.btn-primary {
    background: var(--laranja-solar);
    color: var(--branco);
}

.btn-primary:hover {
    background: #e55a2b;
    transform: translateY(-3px);
    box-shadow: var(--sombra-hover);
}

.btn-secondary {
    background: transparent;
    color: var(--branco);
    border: 2px solid var(--branco);
}

.btn-secondary:hover {
    background: var(--branco);
    color: var(--azul-escuro);
    transform: translateY(-3px);
}

.scroll-indicator {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    animation: bounce 2s infinite;
    z-index: 2;
}

.scroll-indicator i {
    font-size: 30px;
    color: var(--branco);
}

/* ===== STATS SECTION ===== */
.stats {
    background: var(--branco);
    padding: 60px 0;
    margin-top: -50px;
    position: relative;
    z-index: 10;
    border-radius: 20px;
    box-shadow: var(--sombra-hover);
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
}

.stat-card {
    text-align: center;
    padding: 20px;
}

.stat-card i {
    font-size: 40px;
    color: var(--azul-piscina);
    margin-bottom: 15px;
}

.stat-number {
    font-size: 48px;
    font-weight: 700;
    color: var(--azul-escuro);
    font-family: 'Montserrat', sans-serif;
}

.stat-label {
    font-size: 14px;
    color: var(--cinza-medio);
    margin-top: 5px;
}

/* ===== ABOUT SECTION ===== */
.about {
    background: var(--cinza-claro);
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
}

.about-image {
    position: relative;
}

.img-main {
    width: 100%;
    border-radius: 15px;
    box-shadow: var(--sombra-hover);
}

.about-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 15px;
}

.about-images img {
    width: 100%;
    border-radius: 10px;
    box-shadow: var(--sombra);
}

.about-content h2 {
    margin-bottom: 20px;
}

.about-text {
    margin-bottom: 20px;
    text-align: justify;
}

.about-features {
    margin-top: 30px;
}

.feature {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
}

.feature i {
    color: var(--verde-energia);
    font-size: 20px;
}

/* ===== HEATING SECTION ===== */
.heating {
    background: var(--branco);
}

.heating-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 50px;
}

.heating-card {
    background: var(--branco);
    border-radius: 15px;
    overflow: hidden;
    box-shadow: var(--sombra);
    transition: all 0.3s ease;
}

.heating-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--sombra-hover);
}

.card-image {
    height: 200px;
    overflow: hidden;
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
}

.heating-card:hover .card-image img {
    transform: scale(1.1);
}

.card-content {
    padding: 25px;
}

.card-content h3 {
    color: var(--azul-escuro);
    margin-bottom: 15px;
    font-size: 22px;
}

.card-content p {
    color: var(--cinza-medio);
    margin-bottom: 20px;
}

.card-list {
    list-style: none;
    margin-bottom: 20px;
}

.card-list li {
    padding: 8px 0;
    display: flex;
    align-items: center;
    gap: 10px;
}

.card-list i {
    color: var(--verde-energia);
}

.btn-card {
    background: var(--azul-piscina);
    color: var(--branco);
    border: none;
    padding: 10px 25px;
    border-radius: 25px;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: 600;
}

.btn-card:hover {
    background: var(--laranja-solar);
}

.chart-container,
.table-container {
    background: var(--cinza-claro);
    padding: 40px;
    border-radius: 15px;
    margin-top: 50px;
}

.chart-container h3,
.table-container h3 {
    text-align: center;
    margin-bottom: 30px;
    color: var(--azul-escuro);
}

.comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--branco);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--sombra);
}

.comparison-table th,
.comparison-table td {
    padding: 15px;
    text-align: left;
    border-bottom: 1px solid #ddd;
}

.comparison-table th {
    background: var(--azul-piscina);
    color: var(--branco);
    font-weight: 600;
}

.comparison-table tr:hover {
    background: var(--cinza-claro);
}

/* ===== LED SECTION ===== */
.led {
    background: linear-gradient(135deg, #f0f8ff, #e6f3ff);
}

.led-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
    margin-bottom: 50px;
}

.led-content h3 {
    font-size: 28px;
    margin-bottom: 20px;
    color: var(--azul-escuro);
}

.led-content p {
    margin-bottom: 30px;
    text-align: justify;
}

.led-features {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.led-feature {
    display: flex;
    align-items: center;
    gap: 15px;
    background: var(--branco);
    padding: 20px;
    border-radius: 10px;
    box-shadow: var(--sombra);
}

.led-feature i {
    font-size: 30px;
    color: var(--laranja-solar);
}

.led-feature h4 {
    margin-bottom: 5px;
    color: var(--azul-escuro);
}

.led-feature p {
    margin: 0;
    font-size: 14px;
    color: var(--cinza-medio);
}

.led-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.led-main {
    grid-column: 1 / -1;
    width: 100%;
    border-radius: 15px;
    box-shadow: var(--sombra-hover);
}

.led-secondary {
    width: 100%;
    border-radius: 10px;
    box-shadow: var(--sombra);
}

/* Color Simulator */
.color-simulator {
    background: var(--branco);
    padding: 40px;
    border-radius: 15px;
    margin-top: 50px;
    box-shadow: var(--sombra);
}

.color-simulator h3 {
    text-align: center;
    margin-bottom: 15px;
}

.color-simulator > p {
    text-align: center;
    margin-bottom: 30px;
    color: var(--cinza-medio);
}

.color-controls {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: center;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

#colorPicker {
    width: 80px;
    height: 80px;
    border: none;
    border-radius: 50%;
    cursor: pointer;
}

.color-presets {
    display: flex;
    gap: 10px;
}

.color-preset {
    width: 50px;
    height: 50px;
    border: 3px solid var(--branco);
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.3s;
    box-shadow: var(--sombra);
}

.color-preset:hover {
    transform: scale(1.2);
}

.color-preview {
    position: relative;
    border-radius: 15px;
    overflow: hidden;
    height: 400px;
}

.color-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.preview-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 168, 232, 0.4);
    transition: background 0.3s;
}

/* ===== SYSTEM SECTION ===== */
.system {
    background: var(--branco);
}

.system-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    margin-bottom: 50px;
}

.system-card {
    background: var(--cinza-claro);
    padding: 40px 25px;
    border-radius: 15px;
    text-align: center;
    transition: all 0.3s;
}

.system-card:hover {
    background: var(--azul-piscina);
    color: var(--branco);
    transform: translateY(-5px);
}

.system-card i {
    font-size: 48px;
    margin-bottom: 20px;
    color: var(--laranja-solar);
}

.system-card:hover i {
    color: var(--branco);
}

.system-card h3 {
    margin-bottom: 15px;
    font-size: 20px;
}

/* Dashboard */
.dashboard-sim {
    background: var(--cinza-claro);
    padding: 40px;
    border-radius: 15px;
}

.dashboard-sim h3 {
    text-align: center;
    margin-bottom: 30px;
}

.dashboard {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    background: var(--branco);
    padding: 30px;
    border-radius: 15px;
    box-shadow: var(--sombra);
}

.dashboard-panel {
    background: var(--cinza-claro);
    padding: 20px;
    border-radius: 10px;
    text-align: center;
}

.dashboard-panel h4 {
    margin-bottom: 15px;
    color: var(--azul-escuro);
}

.temp-control,
.light-control,
.pump-control {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
}

input[type="range"] {
    width: 100%;
}

.btn-toggle {
    background: var(--cinza-medio);
    color: var(--branco);
    border: none;
    padding: 10px 20px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-toggle.active {
    background: var(--verde-energia);
}

.status {
    font-size: 14px;
    color: var(--cinza-medio);
}

.consumption {
    font-size: 32px;
    font-weight: 700;
    color: var(--laranja-solar);
}

.consumption small {
    display: block;
    font-size: 14px;
    color: var(--cinza-medio);
    margin-top: 5px;
}

/* ===== SIMULATORS SECTION ===== */
.simulators {
    background: var(--cinza-claro);
}

.simulator-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 50px;
}

.simulator-card {
    background: var(--branco);
    padding: 30px;
    border-radius: 15px;
    box-shadow: var(--sombra);
}

.simulator-card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 25px;
    color: var(--azul-escuro);
}

.simulator-card h3 i {
    color: var(--laranja-solar);
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--azul-escuro);
}

.form-group input,
.form-group select {
    width: 100%;
    padding: 12px;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
    transition: border-color 0.3s;
}

.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: var(--azul-piscina);
}

.result {
    margin-top: 20px;
    padding: 20px;
    background: var(--cinza-claro);
    border-radius: 10px;
    display: none;
}

.result.show {
    display: block;
    animation: fadeIn 0.5s;
}

.result h4 {
    color: var(--verde-energia);
    margin-bottom: 10px;
}

.result p {
    margin: 5px 0;
    font-size: 14px;
}

/* ===== GALLERY SECTION ===== */
.gallery {
    background: var(--branco);
}

.gallery-filter {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 40px;
    flex-wrap: wrap;
}

.filter-btn {
    padding: 10px 25px;
    border: 2px solid var(--azul-piscina);
    background: transparent;
    color: var(--azul-piscina);
    border-radius: 25px;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: 600;
}

.filter-btn:hover,
.filter-btn.active {
    background: var(--azul-piscina);
    color: var(--branco);
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.gallery-item {
    position: relative;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: var(--sombra);
    cursor: pointer;
    aspect-ratio: 1;
}

.gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
}

.gallery-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 59, 92, 0.8);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s;
    color: var(--branco);
    padding: 20px;
    text-align: center;
}

.gallery-item:hover .gallery-overlay {
    opacity: 1;
}

.gallery-item:hover img {
    transform: scale(1.1);
}

.gallery-overlay h4 {
    font-size: 20px;
    margin-bottom: 10px;
}

/* ===== SUSTAINABILITY SECTION ===== */
.sustainability {
    background: linear-gradient(135deg, var(--verde-energia), #5cb85c);
    color: var(--branco);
}

.sustainability .section-title,
.sustainability .section-subtitle {
    color: var(--branco);
}

.sustainability-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    margin-bottom: 50px;
}

.sustain-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 30px;
    border-radius: 15px;
    text-align: center;
    transition: all 0.3s;
}

.sustain-card:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-5px);
}

.sustain-card i {
    font-size: 48px;
    margin-bottom: 20px;
}

.sustain-card h3 {
    margin-bottom: 15px;
    font-size: 20px;
}

.sustainability-chart {
    background: rgba(255, 255, 255, 0.9);
    padding: 40px;
    border-radius: 15px;
    max-width: 800px;
    margin: 0 auto;
}

/* ===== CONTACT SECTION ===== */
.contact {
    background: var(--cinza-claro);
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
}

.contact-info h3 {
    font-size: 28px;
    margin-bottom: 10px;
    color: var(--azul-escuro);
}

.contact-info > p {
    color: var(--cinza-medio);
    margin-bottom: 30px;
}

.info-item {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.info-item i {
    font-size: 20px;
    color: var(--azul-piscina);
    width: 40px;
    height: 40px;
    background: var(--branco);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--sombra);
}

.social-links {
    display: flex;
    gap: 15px;
    margin-top: 30px;
}

.social-links a {
    width: 45px;
    height: 45px;
    background: var(--azul-piscina);
    color: var(--branco);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    transition: all 0.3s;
}

.social-links a:hover {
    background: var(--laranja-solar);
    transform: translateY(-3px);
}

.contact-form {
    background: var(--branco);
    padding: 40px;
    border-radius: 15px;
    box-shadow: var(--sombra-hover);
}

.contact-form .form-group {
    margin-bottom: 20px;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 15px;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
    font-family: 'Open Sans', sans-serif;
    transition: border-color 0.3s;
}

.contact-form input:focus,
.contact-form textarea:focus {
    outline: none;
    border-color: var(--azul-piscina);
}

/* ===== FOOTER ===== */
.footer {
    background: var(--azul-escuro);
    color: var(--branco);
    padding: 60px 0 30px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
}

.footer-col h4 {
    font-size: 20px;
    margin-bottom: 20px;
    color: var(--azul-piscina);
}

.footer-col ul {
    list-style: none;
}

.footer-col ul li {
    margin-bottom: 10px;
}

.footer-col a {
    color: var(--branco);
    text-decoration: none;
    transition: color 0.3s;
}

.footer-col a:hover {
    color: var(--azul-piscina);
}

.footer-bottom {
    text-align: center;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 14px;
    opacity: 0.8;
}

/* ===== MODAL ===== */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal.show {
    display: flex;
}

.modal-content {
    background: var(--branco);
    padding: 40px;
    border-radius: 15px;
    max-width: 600px;
    width: 100%;
    max-height: 80vh;
    overflow-y: auto;
    position: relative;
    animation: fadeIn 0.3s;
}

.modal-close {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 30px;
    cursor: pointer;
    color: var(--cinza-medio);
    transition: color 0.3s;
}

.modal-close:hover {
    color: var(--azul-escuro);
}

/* ===== ANIMATIONS ===== */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
        transform: translateX(-50%) translateY(0);
    }
    40% {
        transform: translateX(-50%) translateY(-10px);
    }
    60% {
        transform: translateX(-50%) translateY(-5px);
    }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
    .stats-grid,
    .system-grid,
    .sustainability-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .heating-grid,
    .simulator-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .about-grid,
    .led-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }
    
    .footer-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .menu-toggle {
        display: block;
    }
    
    .nav {
        position: fixed;
        top: 70px;
        right: -100%;
        width: 100%;
        height: calc(100vh - 70px);
        background: var(--branco);
        transition: right 0.3s;
    }
    
    .nav.active {
        right: 0;
    }
    
    .nav-list {
        flex-direction: column;
        align-items: center;
        padding: 40px 0;
    }
    
    .hero-title {
        font-size: 36px;
    }
    
    .hero-subtitle {
        font-size: 20px;
    }
    
    .section-title {
        font-size: 28px;
    }
    
    .stats-grid,
    .heating-grid,
    .system-grid,
    .simulator-grid,
    .sustainability-grid,
    .gallery-grid {
        grid-template-columns: 1fr;
    }
    
    .dashboard {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .led-images {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .hero-buttons {
        flex-direction: column;
    }
    
    .btn {
        width: 100%;
    }
    
    .stats {
        margin-top: 0;
        border-radius: 0;
    }
    
    .dashboard {
        grid-template-columns: 1fr;
    }
}
